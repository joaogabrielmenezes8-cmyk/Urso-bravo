@@ -0,0 +1,23 @@
+export interface QuestionNoticeContext {
+  status: "available" | "pending_question" | "pending_attempt" | "pending_notice" | "pending_references";
+  notice_id?: string;
+  revision_id?: string;
+  cutoff_on?: string;
+  references?: Array<{
+    title: string;
+    label: string | null;
+    law_code: string;
+    article_key: string;
+    version_id: string;
+    body: string;
+    source_url: string;
+  }>;
+}
+
+export function tutorNoticeEvidence(context: QuestionNoticeContext): string | null {
+  if (context.status !== "available" || !context.cutoff_on || !context.references?.length) return null;
+  const citations = context.references.map(
+    (ref) => [ref.title, ref.label, ref.body, ref.source_url].filter(Boolean).join("\n"),
+  );
+  return ["Data de corte: " + context.cutoff_on, ...citations].join("\n\n");
+}
