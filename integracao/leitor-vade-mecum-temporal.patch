+import { normalizeQuestionText } from "@/lib/normalize-question-text";
+import { useQuestionNoticeContext } from "./question-notice-reading";
+
+/** Editorial notes kept apart from resolved legal text; never sent to the tutor as evidence. */
+export function EditorialCommentaryView({ explanation, legalBasis, certified }: {
+  explanation: string | null | undefined; legalBasis: string | null | undefined; certified: boolean;
+}) {
+  if (!explanation?.trim() && !legalBasis?.trim()) return null;
+  return (
+    <section aria-label="Comentário editorial" className="mb-3 space-y-2 rounded-lg border border-dashed border-border p-3 text-sm">
+      <h2 className="font-semibold">Comentário editorial</h2>
+      {!certified && <p role="note" className="text-xs text-muted-foreground">Contexto temporal ainda não certificado para o edital. Este comentário é editorial e não substitui a redação legal do edital.</p>}
+      {explanation?.trim() && <p className="whitespace-pre-line leading-relaxed text-muted-foreground">{normalizeQuestionText(explanation)}</p>}
+      {legalBasis?.trim() && <p className="text-xs text-muted-foreground"><strong>Base legal citada no comentário:</strong> {legalBasis}</p>}
+    </section>
+  );
+}
+
+export function EditorialCommentary({ questionId, attemptId, explanation, legalBasis }: {
+  questionId: string; attemptId?: string | undefined; explanation: string | null | undefined; legalBasis: string | null | undefined;
+}) {
+  const { data } = useQuestionNoticeContext(questionId, attemptId);
+  return <EditorialCommentaryView explanation={explanation} legalBasis={legalBasis} certified={data?.status === "available"} />;
+}
