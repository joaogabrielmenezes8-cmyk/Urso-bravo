+import { useQuery } from "@tanstack/react-query";
+import { untypedSupabase } from "@/lib/supabase";
+import { formatLegalReadingText } from "@/lib/legal-reading-format";
+
+interface NoticeOption {
+  id: string;
+  title: string;
+}
+
+interface NoticeVersion {
+  status: "available" | "revoked" | "pending_notice" | "pending_version" | "outside_recorded_scope";
+  cutoff_on: string | null;
+  heading: string | null;
+  body: string | null;
+  source_url: string | null;
+  edition_source_url: string | null;
+}
+
+interface Props {
+  noticeId: string;
+  setNoticeId: (value: string) => void;
+  mode: "current" | "notice" | "compare";
+  setMode: (value: "current" | "notice" | "compare") => void;
+  provisionId: string | null;
+  currentBody: string | null;
+  fontSize: number;
+  userId: string | undefined;
+}
+
+export function NoticeLegalReading({
+  noticeId, setNoticeId, mode, setMode, provisionId, currentBody, fontSize, userId,
+}: Props) {
+  const notices = useQuery({
+    queryKey: ["notice-legal-options", userId],
+    enabled: Boolean(userId),
+    queryFn: async () => {
+      const result = await untypedSupabase.from("notices").select("id,title").order("year", { ascending: false });
+      if (result.error) throw result.error;
+      return (result.data ?? []) as NoticeOption[];
+    },
+  });
+  const historical = useQuery({
+    queryKey: ["notice-legal-version", userId, noticeId, provisionId],
+    enabled: Boolean(userId && provisionId && noticeId && mode !== "current"),
+    retry: false,
+    queryFn: async () => {
+      const result = await untypedSupabase.rpc("resolve_notice_legal_provision", {
+        p_notice_id: noticeId,
+        p_provision_id: provisionId,
+      });
+      if (result.error) throw result.error;
+      return (result.data as NoticeVersion[] | null)?.[0] ?? null;
+    },
+  });
+  if (!userId) return null;
+
+  const version = historical.data;
+  const equal = version?.status === "available" && currentBody
+    ? formatLegalReadingText(version.body ?? "") === formatLegalReadingText(currentBody)
+    : null;
+  const historicalReady = Boolean(noticeId && provisionId);
+  return (
+    <section aria-label="Redação legislativa" className="space-y-3 rounded-lg border border-border p-3">
+      <label className="block text-sm font-semibold">
+        Redação legislativa
+        <select aria-label="Redação legislativa" className="mt-1 block w-full rounded-md border border-border bg-background p-2"
+          value={mode} onChange={(event) => {
+            const value = event.target.value;
+            if (value === "current" || value === "notice" || value === "compare") setMode(value);
+          }}>
+          <option value="current">Legislação atual</option>
+          <option value="notice">Legislação do edital</option>
+          <option value="compare">Comparar redações</option>
+        </select>
+      </label>
+      {mode !== "current" && <>
+        <label className="block text-sm font-semibold">
+          Edital
+          <select className="mt-1 block w-full rounded-md border border-border bg-background p-2"
+            value={noticeId} onChange={(event) => setNoticeId(event.target.value)}>
+            <option value="">Selecionar edital</option>
+            {notices.data?.map((notice) => <option key={notice.id} value={notice.id}>{notice.title}</option>)}
+          </select>
+        </label>
+        {notices.isError && <p role="alert">Não foi possível carregar os editais.</p>}
+        {!historicalReady && <p role="status">Selecione um edital e um dispositivo cadastrado para consultar a redação histórica.</p>}
+        {historicalReady && historical.isPending && <p role="status">Consultando redação do edital…</p>}
+        {historical.isError && <p role="alert">A consulta histórica está indisponível. Você pode abrir a legislação atual no seletor.</p>}
+        {version && <div className="space-y-2">
+          {version.cutoff_on && <p className="text-sm font-semibold">Data de corte do edital: {version.cutoff_on.split("-").reverse().join("/")}</p>}
+          {version.status === "outside_recorded_scope"
+            ? <p role="status">Dispositivo sem vínculo registrado com este edital.</p>
+            : (version.status === "pending_notice" || version.status === "pending_version") && <p role="status">Redação histórica pendente de certificação.</p>}
+          {version.status === "revoked" && <p role="status">Dispositivo revogado na data de corte.</p>}
+          {version.status === "available" && <>
+            {version.heading && <h3 className="font-bold">{version.heading}</h3>}
+            <p className="whitespace-pre-line break-words text-justify" lang="pt-BR" style={{ fontSize, lineHeight: 1.8 }}>
+              {formatLegalReadingText(version.body ?? "")}
+            </p>
+          </>}
+          {mode === "compare" && equal !== null && <p className="text-sm font-semibold">
+            {equal ? "As redações exibidas são iguais." : "O texto atual difere da redação do edital."}
+          </p>}
+          <div className="flex flex-wrap gap-3 text-sm">
+            {version.source_url && <a className="underline" href={version.source_url} rel="noreferrer" target="_blank">Fonte da redação</a>}
+            {version.edition_source_url && <a className="underline" href={version.edition_source_url} rel="noreferrer" target="_blank">Fonte do edital</a>}
+          </div>
+        </div>}
+      </>}
+    </section>
+  );
+}
