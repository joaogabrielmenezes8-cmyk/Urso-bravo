+}));
+vi.mock("@/lib/auth", () => ({ useAuth: () => ({ user: { id: STUDENT } }) }));
+vi.mock("@tanstack/react-router", () => ({ Link: ({ children }: { children: unknown }) => children }));
+// AI stub: no real provider call, no cost.
+const ai = vi.hoisted(() => ({ calls: [] as string[] }));
