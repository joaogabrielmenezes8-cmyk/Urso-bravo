+import { Link } from "@tanstack/react-router";
+import { useQuery } from "@tanstack/react-query";
+import { untypedSupabase } from "@/lib/supabase";
+import { useAuth } from "@/lib/auth";
+import type { QuestionNoticeContext } from "@/lib/question-notice-context";
+
+export function useQuestionNoticeContext(questionId: string, attemptId?: string) {
+  const { user } = useAuth();
+  return useQuery({
+    queryKey: ["question-notice-context", user?.id, questionId, attemptId],
+    enabled: Boolean(user),
+    retry: false,
+    queryFn: async () => {
+      const result = await untypedSupabase.rpc("resolve_question_notice_legal_context", {
+        p_question_id: questionId, ...(attemptId ? { p_attempt_id: attemptId } : {}),
+      });
+      if (result.error) throw result.error;
+      return result.data as QuestionNoticeContext;
+    },
+  });
+}
+
+export function QuestionNoticeReading({ questionId, attemptId }: { questionId: string; attemptId?: string }) {
+  const { user } = useAuth();
+  const query = useQuestionNoticeContext(questionId, attemptId);
+  const context = query.data;
+  return (
+    <section aria-label="Legislação do edital" className="space-y-2 rounded-lg border border-border p-3 text-sm">
+      <h2 className="font-semibold">Legislação do edital</h2>
+      {user && query.isPending && <p role="status">Consultando a redação do edital…</p>}
+      {(!user || query.isError || (context && context.status !== "available")) &&
+        <p role="status">Fundamentação legislativa do edital pendente de certificação ou indisponível.</p>}
+      {context?.cutoff_on && <p>Data de corte: {context.cutoff_on.split("-").reverse().join("/")}</p>}
+      {context?.references?.map((ref, index) => (
+        <details key={ref.version_id + ":" + index}>
+          <summary>{ref.title} {ref.label}</summary>
+          <p className="whitespace-pre-line">{ref.body}</p>
+          <a href={ref.source_url} target="_blank" rel="noreferrer" className="mr-3 underline">Fonte da redação</a>
+          <Link to="/app/ementario" search={{law: ref.law_code, article: ref.article_key,
+            edital: context.notice_id, revisao: context.revision_id}} target="_blank" rel="noopener noreferrer" className="underline">Abrir no Vade Mecum</Link>
+        </details>
+      ))}
+    </section>
+  );
+}
