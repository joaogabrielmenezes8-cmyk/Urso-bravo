@@ -0,0 +1,37 @@
+import { describe, expect, it } from "vitest";
+import { tutorNoticeEvidence, type QuestionNoticeContext } from "./question-notice-context";
+
+const reference = {
+  title: "Norma de teste",
+  label: "Art. 1",
+  law_code: "TESTE",
+  article_key: "art-00001",
+  version_id: "fixture-version",
+  body: "Redação aplicável ao edital",
+  source_url: "https://example.test/ato",
+};
+
+describe("contexto temporal do tutor", () => {
+  it("recusa fundamentação parcial mesmo quando há um dispositivo conferido", () => {
+    const context: QuestionNoticeContext = {
+      status: "pending_references", cutoff_on: "2024-05-09", references: [reference],
+    };
+    expect(tutorNoticeEvidence(context)).toBeNull();
+  });
+
+  it("usa o texto e a fonte da revisão selecionada", () => {
+    const context: QuestionNoticeContext = {
+      status: "available", cutoff_on: "2024-05-09", references: [reference],
+    };
+    expect(tutorNoticeEvidence(context)).toBe(
+      ["Data de corte: 2024-05-09", [
+        reference.title, reference.label, reference.body, reference.source_url,
+      ].join("\n")].join("\n\n"),
+    );
+  });
+
+  it("não monta contexto sem data de corte nem sem texto certificado", () => {
+    expect(tutorNoticeEvidence({ status: "available", references: [reference] })).toBeNull();
+    expect(tutorNoticeEvidence({ status: "available", cutoff_on: "2024-05-09", references: [] })).toBeNull();
+  });
+});
